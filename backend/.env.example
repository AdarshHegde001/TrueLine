# Copy this file to .env and fill in GEMINI_API_KEY.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL host port matches data_ingestion/docker-compose.yml.
DATABASE_URL=postgresql://trueline:trueline@localhost:5433/trueline

# Use "fake" for a fast plumbing demo (not semantic retrieval); use "bge-m3"
# for real BAAI/bge-m3 vectors. The default is bge-m3.
INGESTION_EMBEDDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=main

# Get an API key from Google AI Studio. Keep it on the backend.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite

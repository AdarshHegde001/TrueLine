# Copy this file to .env and configure model endpoints and keys below.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
TRUELINE_BRAND_ID=brand_lumina
TRUELINE_ORGANIZATION_NAME=Lumina Studio

# PostgreSQL host port matches data_ingestion/docker-compose.yml.
DATABASE_URL=postgresql://trueline:trueline@localhost:5433/trueline

# Real BAAI/bge-m3 dense embeddings (1024 dimensions).
INGESTION_EMBEDDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=main

# Each agent has a separate API key variable. They currently share Gemini's
# OpenAI-compatible endpoint and model; add a different key to each variable.
TRUELINE_TONE_PROVIDER=gemini
TRUELINE_TONE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TRUELINE_TONE_API_KEY=
TRUELINE_TONE_MODEL=gemini-3.1-flash-lite
TRUELINE_TONE_TIMEOUT_SECONDS=120

TRUELINE_CLAIMS_PROVIDER=gemini
TRUELINE_CLAIMS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TRUELINE_CLAIMS_API_KEY=
TRUELINE_CLAIMS_MODEL=gemini-3.1-flash-lite
TRUELINE_CLAIMS_TIMEOUT_SECONDS=120

TRUELINE_SUMMARY_PROVIDER=gemini
TRUELINE_SUMMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TRUELINE_SUMMARY_API_KEY=
TRUELINE_SUMMARY_MODEL=gemini-3.1-flash-lite
TRUELINE_SUMMARY_TIMEOUT_SECONDS=120
